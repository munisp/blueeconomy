{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueeconomy.example/schemas/blueeconomy.protected-promotion-closeout.v1.schema.json",
  "title": "Blue Economy Protected Promotion Closeout Attestation",
  "description": "Repository-owned structural baseline. Ministry compliance policy, signer authorization and signature trust must be supplied externally and verified separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "status",
    "attestation_id",
    "issued_at",
    "expires_at",
    "scope",
    "candidate",
    "required_evidence",
    "automated_checks",
    "review",
    "promotion_decision",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "blueeconomy.protected-promotion-closeout.v1"},
    "document_type": {"enum": ["template_only", "ministry_controlled_attestation"]},
    "status": {"enum": ["template_not_signed_not_approved", "pending_authorized_signature", "approved", "rejected", "expired"]},
    "attestation_id": {"$ref": "#/$defs/reference"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_reference", "namespace_reference", "change_authorization_reference", "promotion_mode"],
      "properties": {
        "environment_reference": {"$ref": "#/$defs/reference"},
        "namespace_reference": {"$ref": "#/$defs/reference"},
        "change_authorization_reference": {"$ref": "#/$defs/reference"},
        "promotion_mode": {"const": "gitops_only"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit_sha", "environment_overlay_commit_sha", "rendered_manifest_sha256", "external_secret_manifest_sha256", "image_and_chart_digest_set_sha256"],
      "properties": {
        "source_commit_sha": {"$ref": "#/$defs/git_sha"},
        "environment_overlay_commit_sha": {"$ref": "#/$defs/git_sha"},
        "rendered_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "external_secret_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "image_and_chart_digest_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "automated_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "run_reference", "source_commit_sha", "status"],
        "properties": {
          "name": {"$ref": "#/$defs/reference"},
          "run_reference": {"$ref": "#/$defs/reference"},
          "source_commit_sha": {"$ref": "#/$defs/git_sha"},
          "status": {"enum": ["passed", "failed", "skipped"]}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_reviewer_role", "review_outcome", "findings_reference", "exception_reference"],
      "properties": {
        "independent_reviewer_role": {"$ref": "#/$defs/reference"},
        "review_outcome": {"enum": ["pending_authorized_signature", "accepted", "rejected", "exception_accepted"]},
        "findings_reference": {"$ref": "#/$defs/reference_or_none"},
        "exception_reference": {"$ref": "#/$defs/reference_or_none"}
      }
    },
    "promotion_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "gitops_reconciler_reference", "rollback_reference", "post_promotion_verification_reference"],
      "properties": {
        "decision": {"enum": ["not_approved_template_only", "pending_authorized_signature", "approved", "rejected", "expired"]},
        "gitops_reconciler_reference": {"$ref": "#/$defs/reference"},
        "rollback_reference": {"$ref": "#/$defs/reference"},
        "post_promotion_verification_reference": {"$ref": "#/$defs/reference"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "algorithm", "signer_key_id", "signature_reference", "signature_value"],
      "properties": {
        "status": {"enum": ["placeholder_not_a_signature", "not_signed", "present", "verified", "rejected"]},
        "algorithm": {"$ref": "#/$defs/reference"},
        "signer_key_id": {"$ref": "#/$defs/reference"},
        "signature_reference": {"$ref": "#/$defs/reference"},
        "signature_value": {"type": "string", "minLength": 1, "maxLength": 8192}
      }
    }
  },
  "$defs": {
    "reference": {"type": "string", "pattern": "^[A-Za-z0-9._:/@+=-]{3,512}$"},
    "reference_or_none": {"type": "string", "pattern": "^(NONE|[A-Za-z0-9._:/@+=-]{3,512})$"},
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "kind", "reference", "sha256", "status"],
      "properties": {
        "control": {"pattern": "^P([1-9]|1[0-8])(-P([1-9]|1[0-8]))?$", "type": "string"},
        "kind": {"$ref": "#/$defs/reference"},
        "reference": {"$ref": "#/$defs/reference"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["required", "verified", "rejected", "expired"]}
      }
    }
  }
}
