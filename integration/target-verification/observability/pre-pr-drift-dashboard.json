{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Candidate Binding Block",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "max(blueeconomy_gitops_candidate_binding_blocking{mode=\"candidate\"})", "legendFormat": "blocking"}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Reconciliation Outcomes",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 0},
      "targets": [{"refId": "A", "expr": "sum by (result) (increase(blueeconomy_gitops_candidate_reconciliation_total[$__rate_interval]))", "legendFormat": "{{result}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 3,
      "type": "table",
      "title": "Mismatch Fields",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "sum by (field) (increase(blueeconomy_gitops_candidate_binding_mismatch_total[$__rate_interval]))", "format": "table", "instant": true, "legendFormat": "{{field}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "External Contact Attempted",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [{"refId": "A", "expr": "max(blueeconomy_gitops_candidate_external_contact_attempted)", "legendFormat": "external_contact"}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Mismatch Rate by Bounded Field",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [{"refId": "A", "expr": "sum by (field) (increase(blueeconomy_gitops_candidate_binding_mismatch_total[$__rate_interval]))", "legendFormat": "{{field}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["blueeconomy", "gitops", "candidate-binding", "offline-safety"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "utc",
  "title": "Blue Economy GitOps Candidate Binding",
  "uid": "blueeco-gitops-binding",
  "version": 1
}
